install.packages("nimble")
library(nimble)
N = 10
y = c(2,1,1,0,1,1,2,1,1,0)
sleepyCode <- nimbleCode({
for (i in 1:N){
y[i] ~ dpois(p)
}
p ~ dgamma(1.1,1)
})
sleepyData <- list(y=y)
sleepyConsts <- list(N=N)
sleepy.out <- nimbleMCMC(code = sleepyCode,
constants = sleepyConsts,
data = sleepyData,
nchains = 4, niter = 5000, nburnin = 1000,
samplesAsCodaMCMC = TRUE,
summary = TRUE, WAIC = TRUE,
monitors = c('p'))
st=Sys.time()
for(i in 1:10) test = solve(matrix(rnorm(3000^2),3000,3000))
Sys.time()-st
