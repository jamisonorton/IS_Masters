library(caret)
library(RWeka)
library(kernlab)
library(rminer)
library(matrixStats)
library(knitr)
library(tidyverse)
mydir <- getwd()
setwd(mydir)
nasales <- read.csv(file = "NA_sales_filtered.csv", stringsAsFactors = FALSE, fileEncoding = "latin1")
# Remove the Name variable from the data frame
nasales_model <- nasales %>%
select(-Name)
nasales_model <- nasales_model %>%
mutate(across(where(is.character), as.factor))
df <- nasales_model
target <- "NA_Sales"
seedVal <- 500
metrics_list <- c("MAE","RMSE","MAPE","RMSPE","RAE","RRSE","R2")
# Create a 70/30 training/testing split based on the target variable
set.seed(seedVal)
train_index <- createDataPartition(
nasales_model$NA_Sales,
p = 0.70,
list = FALSE
)
# Partition the data
train <- nasales_model[train_index, ]
test <- nasales_model[-train_index, ]
# Designate a shortened name MLP for the MultilayerPerceptron ANN method in RWeka
MLP <- make_Weka_classifier("weka/classifiers/functions/MultilayerPerceptron")
# Build MLP model on the training set using default settings
mlp_default <- MLP(NA_Sales ~ ., data = train)
# Make predictions on the training set
train_pred_default <- predict(mlp_default, newdata = train)
# Make predictions on the testing set
test_pred_default <- predict(mlp_default, newdata = test)
# Evaluate training set performance
train_performance_default <- mmetric(
y = train$NA_Sales,
x = train_pred_default,
metric = metrics_list
)
# Evaluate testing set performance
test_performance_default <- mmetric(
y = test$NA_Sales,
x = test_pred_default,
metric = metrics_list
)
# Combine performance results
mlp_default_results <- rbind(
Training = train_performance_default,
Testing = test_performance_default
)
# Display results
kable(mlp_default_results, digits = 2)
# Change learning rate from the default
l2 <- 0.1
# Build a two-hidden-layer MLP model
model_2 <- MLP(
NA_Sales ~ .,
data = train,
control = Weka_control(
L = l2,
H = "1,1"
)
)
# View model
model_2
# Make predictions on the training set
train_pred_2 <- predict(model_2, newdata = train)
# Make predictions on the testing set
test_pred_2 <- predict(model_2, newdata = test)
# Evaluate training set performance
train_performance_2 <- mmetric(
y = train$NA_Sales,
x = train_pred_2,
metric = metrics_list
)
# Evaluate testing set performance
test_performance_2 <- mmetric(
y = test$NA_Sales,
x = test_pred_2,
metric = metrics_list
)
# Combine performance results
model_2_performance <- rbind(
Training = train_performance_2,
Testing = test_performance_2
)
# Display results
kable(model_2_performance, digits = 4)
# Build ksvm model on the training set using default settings
ksvm_default <- ksvm(NA_Sales ~ ., data = train)
# Make predictions on the training set
train_pred_ksvm_default <- predict(ksvm_default, newdata = train)
# Make predictions on the testing set
test_pred_ksvm_default <- predict(ksvm_default, newdata = test)
# Evaluate training set performance
train_performance_ksvm_default <- mmetric(
y = train$NA_Sales,
x = train_pred_ksvm_default,
metric = metrics_list
)
# Evaluate testing set performance
test_performance_ksvm_default <- mmetric(
y = test$NA_Sales,
x = test_pred_ksvm_default,
metric = metrics_list
)
# Combine performance results
ksvm_default_results <- rbind(
Training = train_performance_ksvm_default,
Testing = test_performance_ksvm_default
)
# Display results
kable(ksvm_default_results, digits = 2)
# Build ksvm model using a different kernel function
# vanilladot is the linear kernel
ksvm_linear <- ksvm(
NA_Sales ~ .,
data = train,
kernel = "vanilladot"
)
# View model
ksvm_linear
# Make predictions on the training set
train_pred_ksvm_linear <- predict(ksvm_linear, newdata = train)
# Make predictions on the testing set
test_pred_ksvm_linear <- predict(ksvm_linear, newdata = test)
# Evaluate training set performance
train_performance_ksvm_linear <- mmetric(
y = train$NA_Sales,
x = train_pred_ksvm_linear,
metric = metrics_list
)
# Evaluate testing set performance
test_performance_ksvm_linear <- mmetric(
y = test$NA_Sales,
x = test_pred_ksvm_linear,
metric = metrics_list
)
# Combine performance results
ksvm_linear_results <- rbind(
Training = train_performance_ksvm_linear,
Testing = test_performance_ksvm_linear
)
# Display results
kable(ksvm_linear_results, digits = 2)
# Set cost value greater than 1
c_value <- 5
# Build ksvm model using a different cost value
ksvm_cost <- ksvm(
NA_Sales ~ .,
data = train,
C = c_value
)
# View model
ksvm_cost
# Make predictions on the training set
train_pred_ksvm_cost <- predict(ksvm_cost, newdata = train)
# Make predictions on the testing set
test_pred_ksvm_cost <- predict(ksvm_cost, newdata = test)
# Evaluate training set performance
train_performance_ksvm_cost <- mmetric(
y = train$NA_Sales,
x = train_pred_ksvm_cost,
metric = metrics_list
)
# Evaluate testing set performance
test_performance_ksvm_cost <- mmetric(
y = test$NA_Sales,
x = test_pred_ksvm_cost,
metric = metrics_list
)
# Combine performance results
ksvm_cost_results <- rbind(
Training = train_performance_ksvm_cost,
Testing = test_performance_ksvm_cost
)
# Display results
kable(ksvm_cost_results, digits = 2)
# Designate a shortened name IBk for the IBk KNN method in RWeka
IBk <- make_Weka_classifier("weka/classifiers/lazy/IBk")
# Build IBk model on the training set using default settings
ibk_default <- IBk(
NA_Sales ~ .,
data = train
)
# View model
ibk_default
# Make predictions on the training set
train_pred_ibk_default <- predict(ibk_default, newdata = train)
# Make predictions on the testing set
test_pred_ibk_default <- predict(ibk_default, newdata = test)
# Evaluate training set performance
train_performance_ibk_default <- mmetric(
y = train$NA_Sales,
x = train_pred_ibk_default,
metric = metrics_list
)
# Evaluate testing set performance
test_performance_ibk_default <- mmetric(
y = test$NA_Sales,
x = test_pred_ibk_default,
metric = metrics_list
)
# Combine performance results
ibk_default_results <- rbind(
Training = train_performance_ibk_default,
Testing = test_performance_ibk_default
)
# Display results
kable(ibk_default_results, digits = 2)
# Set K value
k_value <- 5
# Build IBk model using a different K value
ibk_k <- IBk(
NA_Sales ~ .,
data = train,
control = Weka_control(K = k_value)
)
# View model
ibk_k
# Make predictions on the training set
train_pred_ibk_k <- predict(ibk_k, newdata = train)
# Make predictions on the testing set
test_pred_ibk_k <- predict(ibk_k, newdata = test)
# Evaluate training set performance
train_performance_ibk_k <- mmetric(
y = train$NA_Sales,
x = train_pred_ibk_k,
metric = metrics_list
)
# Evaluate testing set performance
test_performance_ibk_k <- mmetric(
y = test$NA_Sales,
x = test_pred_ibk_k,
metric = metrics_list
)
# Combine performance results
ibk_k_results <- rbind(
Training = train_performance_ibk_k,
Testing = test_performance_ibk_k
)
# Display results
kable(ibk_k_results, digits = 2)
# Build IBk model using weighted voting
ibk_weighted <- IBk(
NA_Sales ~ .,
data = train,
control = Weka_control(I = TRUE)
)
# View model
ibk_weighted
# Make predictions on the training set
train_pred_ibk_weighted <- predict(ibk_weighted, newdata = train)
# Make predictions on the testing set
test_pred_ibk_weighted <- predict(ibk_weighted, newdata = test)
# Evaluate training set performance
train_performance_ibk_weighted <- mmetric(
y = train$NA_Sales,
x = train_pred_ibk_weighted,
metric = metrics_list
)
# Evaluate testing set performance
test_performance_ibk_weighted <- mmetric(
y = test$NA_Sales,
x = test_pred_ibk_weighted,
metric = metrics_list
)
# Combine performance results
ibk_weighted_results <- rbind(
Training = train_performance_ibk_weighted,
Testing = test_performance_ibk_weighted
)
# Display results
kable(ibk_weighted_results, digits = 2)
# Build IBk model using automatic K selection
# K sets the maximum K to consider, and X = TRUE enables cross-validation to choose K
ibk_auto_k <- IBk(
NA_Sales ~ .,
data = train,
control = Weka_control(
K = 10,
X = TRUE
)
)
# View model
ibk_auto_k
# Make predictions on the training set
train_pred_ibk_auto_k <- predict(ibk_auto_k, newdata = train)
# Make predictions on the testing set
test_pred_ibk_auto_k <- predict(ibk_auto_k, newdata = test)
# Evaluate training set performance
train_performance_ibk_auto_k <- mmetric(
y = train$NA_Sales,
x = train_pred_ibk_auto_k,
metric = metrics_list
)
# Evaluate testing set performance
test_performance_ibk_auto_k <- mmetric(
y = test$NA_Sales,
x = test_pred_ibk_auto_k,
metric = metrics_list
)
# Combine performance results
ibk_auto_k_results <- rbind(
Training = train_performance_ibk_auto_k,
Testing = test_performance_ibk_auto_k
)
# Display results
kable(ibk_auto_k_results, digits = 2)
cv_function <- function(df, target, nFolds, seedVal, method, metrics_list)
{
# Create folds using the assigned seed value
set.seed(seedVal)
folds <- createFolds(df[[target]], k = nFolds)
# Create formula from target variable
model_formula <- as.formula(paste(target, "~ ."))
# Cross-validation loop
cv_results <- lapply(folds, function(x)
{
# Split into training and validation folds
train_fold <- df[-x, ]
test_fold <- df[x, ]
# Build model using the method passed into the function
pred_model <- method(
model_formula,
data = train_fold
)
# Predict on validation fold
pred <- predict(pred_model, newdata = test_fold)
# Evaluate performance
mmetric(
y = test_fold[[target]],
x = pred,
metric = metrics_list
)
})
# Convert fold results into a matrix
cv_results_m <- as.matrix(as.data.frame(cv_results))
# Rename columns as Fold 1, Fold 2, etc.
colnames(cv_results_m) <- paste0("Fold_", 1:nFolds)
# Calculate mean and standard deviation across folds
cv_mean <- rowMeans(cv_results_m)
cv_sd <- rowSds(cv_results_m)
# Combine fold-by-fold results with mean and standard deviation
cv_all <- cbind(
cv_results_m,
Mean = cv_mean,
Sd = cv_sd
)
# Display full CV table
kable(cv_all, digits = 2)
}
# 6.A: 3-fold cross-validation of default MLP, ksvm, and IBk models
# Make sure the Weka classifiers are defined
MLP <- make_Weka_classifier("weka/classifiers/functions/MultilayerPerceptron")
IBk <- make_Weka_classifier("weka/classifiers/lazy/IBk")
# 3-fold CV for default MultilayerPerceptron
mlp_cv_3fold <- cv_function(
df = df,
target = target,
nFolds = 3,
seedVal = seedVal,
method = MLP,
metrics_list = metrics_list
)
# 3-fold CV for default ksvm
ksvm_cv_3fold <- cv_function(
df = df,
target = target,
nFolds = 3,
seedVal = seedVal,
method = ksvm,
metrics_list = metrics_list
)
# 3-fold CV for default IBk
ibk_cv_3fold <- cv_function(
df = df,
target = target,
nFolds = 3,
seedVal = seedVal,
method = IBk,
metrics_list = metrics_list
)
cv_function <- function(df, target, nFolds, seedVal, method, metrics_list)
{
# Create folds using the assigned seed value
set.seed(seedVal)
folds <- createFolds(df[[target]], k = nFolds)
# Create formula from target variable
model_formula <- as.formula(paste(target, "~ ."))
# Cross-validation loop
cv_results <- lapply(folds, function(x)
{
# Split into training and validation folds
train_fold <- df[-x, ]
test_fold <- df[x, ]
# Build model using the method passed into the function
pred_model <- method(
model_formula,
data = train_fold
)
# Predict on validation fold
pred <- predict(pred_model, newdata = test_fold)
# Evaluate performance
mmetric(
y = test_fold[[target]],
x = pred,
metric = metrics_list
)
})
# Convert fold results into a matrix
cv_results_m <- as.matrix(as.data.frame(cv_results))
# Rename columns as Fold 1, Fold 2, etc.
colnames(cv_results_m) <- paste0("Fold_", 1:nFolds)
# Calculate mean and standard deviation across folds
cv_mean <- rowMeans(cv_results_m)
cv_sd <- rowSds(cv_results_m)
# Combine fold-by-fold results with mean and standard deviation
cv_all <- cbind(
cv_results_m,
Mean = cv_mean,
Sd = cv_sd
)
# Display full CV table
kable(cv_all, digits = 2)
}
# 6.A: 3-fold cross-validation of default MLP, ksvm, and IBk models
# Make sure the Weka classifiers are defined
MLP <- make_Weka_classifier("weka/classifiers/functions/MultilayerPerceptron")
IBk <- make_Weka_classifier("weka/classifiers/lazy/IBk")
# 3-fold CV for default MultilayerPerceptron
cv_function(
df = df,
target = target,
nFolds = 3,
seedVal = seedVal,
method = MLP,
metrics_list = metrics_list
)
# 3-fold CV for default ksvm
cv_function(
df = df,
target = target,
nFolds = 3,
seedVal = seedVal,
method = ksvm,
metrics_list = metrics_list
)
# 3-fold CV for default IBk
cv_function(
df = df,
target = target,
nFolds = 3,
seedVal = seedVal,
method = IBk,
metrics_list = metrics_list
)
mydir <- getwd()
setwd(mydir)
nasales <- read.csv(file = "NA_sales_filtered.csv", stringsAsFactors = FALSE, fileEncoding = "latin1")
# Remove the Name variable from the data frame
nasales_model <- nasales %>%
select(-Name)
nasales_model <- nasales_model %>%
mutate(across(where(is.character), as.factor))
df <- nasales_model
target <- "NA_Sales"
seedVal <- 500
metrics_list <- c("MAE","RMSE","MAPE","RMSPE","RAE","RRSE","R2")
# Create a 70/30 training/testing split based on the target variable
set.seed(seedVal)
train_index <- createDataPartition(
nasales_model$NA_Sales,
p = 0.70,
list = FALSE
)
# Partition the data
train <- nasales_model[train_index, ]
test <- nasales_model[-train_index, ]
# Inspect the dataset
str(nasales)
summary(nasales_model)
glimpse(nasales_model)
# Check dimensions of full, training, and testing datasets
dim(nasales_model)
dim(train)
dim(test)
