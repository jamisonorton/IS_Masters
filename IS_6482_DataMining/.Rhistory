import mysql.connector
import random
import numpy as np
# Step 1: Establish connection to the MySQL database
def create_connection():
try:
connection = mysql.connector.connect(
host="statdb.byu.edu",  # Change this as needed
user="stat286",  # Update with your database username
password="Cougars24!",  # Update with your database password
database="Pokemon"  # Update with your database name
)
if connection.is_connected():
print("Connected to the database")
return connection
except mysql.connector.Error as err:
print(f"Error: {err}")
return None
# Step 2: Select 6 Pokémon from the database and assign random levels
def select_pokemon(connection):
try:
cursor = connection.cursor()
cursor.execute("SELECT name, type1, type2 FROM pokemon ORDER BY RAND() LIMIT 6;")
selected_pokemon = cursor.fetchall()
# Assign random levels to each Pokémon using a normal distribution with values between 30 and 100
levels = np.random.normal(loc=65, scale=15, size=6).astype(int)
levels = [min(max(30, level), 100) for level in levels]  # Clamping between 30 and 100
team = []
for i, pokemon in enumerate(selected_pokemon):
team.append({
'name': pokemon[0],
'type1': pokemon[1],
'type2': pokemon[2],
'level': levels[i]
})
return team
except mysql.connector.Error as err:
print(f"Error: {err}")
return None
def main():
# Create the database connection
connection = create_connection()
if connection:
# Select 6 Pokémon and assign levels
pokemon_team = select_pokemon(connection)
# Select a random trainer
trainer = select_trainer(connection)
# Display the results
if pokemon_team and trainer:
display_trainer_info(trainer, pokemon_team)
# Close the database connection
connection.close()
if __name__ == "__main__":
main()
