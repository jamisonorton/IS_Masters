library(tidyverse)
library(psych)
library(RWeka)
cloud_wd <- getwd()
setwd(cloud_wd)
titanic <- read.csv(file = "titanic.train.csv", stringsAsFactors = FALSE) # csv file should be in the same folder as your Rmd document. This line of code reads the csv file into the dataframe named titanic.
titanic %>% str()
# create local variables for row and column numbers
row <- nrow(titanic)
row
#should be 891
col <- ncol(titanic)
col
#should be 12
titanic %>% head() ## HEAD FUNCTION HERE
titanic %>% tail() ## TAIL FUNCTION HERE
titanic %>% head(n=10) ## HEAD FUNCTION HERE BUT OVERRIDE THE DEFAULTS use n = 10
titanic %>% tail(n=7) ## TAILFUNCTION HERE use n = 7
titanic %>% summary() # SUMMARY FUNCTION HERE
titanic %>% select(Sex,Age) %>% head() # use head or tail to make sure we don't print the entire dataframe
titanic %>% str()
titanic %>% summarize(across(everything(), ~ sum(is.na(.))))
titanic <- titanic %>% drop_na()
nrow(titanic) # here we check to see how many rows we have now.
# Count empty strings in all columns
# filter to count all nozero columns
titanic %>%
summarize(across(everything(), ~ sum(. == ""))) %>%
t() %>%
as.data.frame() %>%
filter(V1>0)
titanic <- titanic %>%
mutate(Cabin = if_else(Cabin == "","Missing",Cabin),
Embarked = if_else(Embarked == "","Missing",Embarked))
titanic %>%
summarize(across(everything(), ~ sum(. == "")))
# base R version
summary(titanic[c("Sex", "Age")])
#tidyverse version
titanic %>% select(Sex,Age) %>% summary()
# YOU DO.
titanic %>% select(Sex,Age,Fare) %>% summary()
# quintiles and deciles in Base R
quantile(titanic$Fare, seq(from = 0, to = 1, by = 0.20))
quantile(titanic$Fare, seq(from = 0, to = 1, by = 0.10))
# same in tidyverse
titanic %>% pull(Fare) %>% quantile(., seq(from = 0, to = 1, by = 0.20))
titanic %>% pull(Fare) %>% quantile(., seq(from = 0, to = 1, by = 0.10))
# now you do the same for Age
titanic %>% pull(Fare) %>% quantile(., seq(from = 0, to = 1, by = 0.20))
titanic %>% pull(Fare) %>% quantile(., seq(from = 0, to = 1, by = 0.10))
