get_tree_size <- function(model) {
model_output <- capture.output(model)
size_line <- grep("Size of the tree", model_output, value = TRUE)
as.numeric(gsub("[^0-9]", "", size_line))
}
tree_sizes <- data.frame(
model = c(
"model_cf_97",
"model_cf_35",
"model_cf_12",
"model_cf_08",
