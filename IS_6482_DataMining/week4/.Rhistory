get_tree_size <- function(model) {
model_output <- capture.output(print(model))
size_line <- grep("Tree size", model_output, value = TRUE)
if (length(size_line) == 0) {
return(NA)
}
as.numeric(gsub("[^0-9]", "", size_line[1]))
}
